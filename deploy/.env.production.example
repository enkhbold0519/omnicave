# OmniCave production settings. Copy to deploy/.env and fill in:   cp .env.production.example .env
# deploy/.env holds secrets - never commit it.

# ---- Public address -------------------------------------------------------
# No domain yet: use the Elastic IP with sslip.io (dots or dashes), e.g. 3.35.12.34 -> 3-35-12-34.sslip.io
# Own domain later: point an A record at the Elastic IP and put the name here (e.g. api.omnicave.com).
SITE_ADDRESS=3-35-12-34.sslip.io

# ---- Database (AWS RDS PostgreSQL) ---------------------------------------------
# postgresql://<user>:<password>@<RDS endpoint>:5432/<database>?sslmode=require
# The password goes into a URL: letters and digits only. Generate one:  openssl rand -hex 24
DATABASE_URL=postgresql://cellar:change-me@omnicave-db.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com:5432/cellar?sslmode=require

# Local time zone: the daily briefing is sent on this clock
TZ=Asia/Seoul

# ---- Clients -------------------------------------------------------------------
# Browser origins allowed to call the API. * is fine: the API uses bearer tokens, not cookies,
# and the webOS display / mobile apps are not browser origins anyway.
CORS_ORIGINS=*

# ---- AI ----------------------------------------------------------------------------
# mock | openai | vllm   (mock needs no key)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VLLM_BASE_URL=
VLLM_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=

# Vision: mock (simulated camera) | http (your model server)
VISION_PROVIDER=mock
VISION_ENDPOINT=
VISION_API_KEY=

# ---- Data sources --------------------------------------------------------------------
WINE_SEARCHER_API_KEY=
NEWS_FEEDS=https://www.decanter.com/feed/,https://vinepair.com/feed/

# ---- Email (codes for verification and password reset) -------------------------------
# log = only printed in `docker compose logs api`. ses = Amazon SES SMTP (create SMTP credentials in the SES
# console; SMTP_HOST e.g. email-smtp.ap-northeast-2.amazonaws.com; EMAIL_FROM must be a verified identity).
EMAIL_PROVIDER=log
# 1 = new accounts must enter the emailed code before logging in. Keep 0 until SES sends real email.
EMAIL_VERIFICATION_REQUIRED=0
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Sensors -------------------------------------------------------------------------
# 1 = simulated climate readings for cellars without a real device (demo). 0 = real devices only.
SIMULATE_SENSORS=1
SENSOR_INTERVAL=5
