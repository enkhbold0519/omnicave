# CellarOS production settings. Copy to deploy/.env and fill in:   cp .env.production.example .env
# deploy/.env holds secrets - never commit it.

# ---- Public address -------------------------------------------------------
# No domain yet: use the Elastic IP with sslip.io (dots or dashes), e.g. 3.35.12.34 -> 3-35-12-34.sslip.io
# Own domain later: point an A record at the Elastic IP and put the name here (e.g. api.cellaros.com).
SITE_ADDRESS=3-35-12-34.sslip.io

# ---- Database ----------------------------------------------------------------
# Letters and digits only (it goes into a URL). Generate one:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Nightly backup time (TZ below) and how many days of backups to keep
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14

# Local time zone: daily briefing pushes and backups run on this clock
TZ=Asia/Seoul

# ---- Clients -------------------------------------------------------------------
# Browser origins allowed to call the API. * is fine: the API uses bearer tokens, not cookies,
# and the webOS display / mobile apps are not browser origins anyway.
CORS_ORIGINS=*

# ---- AI ----------------------------------------------------------------------------
# mock | openai | hf | vllm   (mock needs no key)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_BASE_URL=
VLLM_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Vision: mock (simulated camera) | http (your model server)
VISION_PROVIDER=mock
VISION_ENDPOINT=
VISION_API_KEY=

# ---- Data sources --------------------------------------------------------------------
WINE_SEARCHER_API_KEY=
NEWS_FEEDS=https://www.decanter.com/feed/,https://vinepair.com/feed/

# ---- Sensors -------------------------------------------------------------------------
# 1 = simulated climate readings for cellars without a real device (demo). 0 = real devices only.
SIMULATE_SENSORS=1
SENSOR_INTERVAL=5
