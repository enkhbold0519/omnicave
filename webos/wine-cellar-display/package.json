{
  "name": "wine-cellar-display",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "webos:package": "node scripts/webos.mjs package",
    "webos:install": "node scripts/webos.mjs install",
    "webos:launch": "node scripts/webos.mjs launch",
    "webos:inspect": "node scripts/webos.mjs inspect",
    "webos:deploy": "npm run build && node scripts/webos.mjs deploy",
    "ares": "node scripts/webos.mjs ares"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
