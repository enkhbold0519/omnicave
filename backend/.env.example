# Copy to .env and fill in. Never commit .env.

# LLM provider: mock | hf | openai | vllm
#   mock   : no key needed, templated streaming answers (default)
#   hf     : Hugging Face Inference Providers (OpenAI-compatible router)
#   openai : OpenAI API
#   vllm   : your own OpenAI-compatible server (e.g. vLLM with --enable-lora);
#            each persona's "lora_adapter" is sent as the model name -> server-side LoRA swapping
LLM_PROVIDER=mock

HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

VLLM_BASE_URL=http://localhost:8001/v1
VLLM_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional: real market prices (paid API). Empty -> simulated prices.
WINE_SEARCHER_API_KEY=

# Daily briefing RSS feeds (comma separated). Unreachable -> sample news.
NEWS_FEEDS=https://www.decanter.com/feed/,https://vinepair.com/feed/

# Vision AI: mock (simulated camera) | http (your model server, see edge/vision_server_example.py)
VISION_PROVIDER=mock
VISION_ENDPOINT=http://localhost:8100/detect
VISION_API_KEY=
# a bottle missing from this many consecutive scans is treated as taken out
VISION_MISSING_SCANS=2

# Sensor simulator interval (seconds); SIMULATE_SENSORS=0 turns simulated readings off
SENSOR_INTERVAL=5
SIMULATE_SENSORS=1

DB_PATH=data/cellar.db
CORS_ORIGINS=*

# Database: empty -> SQLite file at DB_PATH (local dev).
# PostgreSQL: postgresql://user:password@host:5432/dbname  (Docker sets this for you)
DATABASE_URL=
